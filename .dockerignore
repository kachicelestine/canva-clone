# Version control
.git
.gitignore

# Dependencies (rebuilt inside container)
node_modules

# Next.js build artefacts
.next
out

# Local env files — never bake secrets into the image
.env
.env.*
!.env.example

# Dev / editor noise
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode
.idea

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# CI / deployment configs not needed at runtime
.vercel
coverage
